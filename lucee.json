{
    "name":"timetracker",
    "lucee":{
        "version":"7.0.0.395"
    },
    "port":8080,
    "shutdownPort":8081,
    "webroot":"./public",
    "openBrowser":"false",
    "jvm":{
        "maxMemory":"512m",
        "minMemory":"128m"
    },
    "urlRewrite":{
        "enabled":true,
        "routerFile":"index.cfm"
    },
    "admin":{
        "enabled":true,
        "password":"#env:WHEELS_LUCEE_ADMIN_PASSWORD#"
    },
    "enableLucee":true,
    "enableREST":false,
    "monitoring":{
        "enabled":false
    },
    "configuration":{
        "datasources":{
            "timetracker":{
                "class":"org.sqlite.JDBC",
                "database":"timetracker",
                "dbdriver":"Other",
                "dsn":"jdbc:sqlite:/app/db/development.sqlite",
                "host":"",
                "password":"",
                "username":""
            },
            "timetracker_test":{
                "class":"org.sqlite.JDBC",
                "database":"timetracker_test",
                "dbdriver":"Other",
                "dsn":"jdbc:sqlite:/app/db/test.sqlite",
                "host":"",
                "password":"",
                "username":""
            }
        },
        "mappings":{
            "/wheels":"../vendor/wheels",
            "/app":"../app",
            "/config":"../config",
            "/tests":"../tests"
        }
    },
    "web":{
        "host":"0.0.0.0",
        "http":{
            "port":"8080"
        },
        "webroot":"public//",
        "rewrites":{
            "enable":"true"
        }
    }
}
