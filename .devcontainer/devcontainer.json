{
  "name": "timetracker-devcontainer",
  "dockerComposeFile": [
    "../docker-compose.yml"
  ],
  "service": "app",
  "runServices": ["app"],
  "workspaceFolder": "/app",
  "shutdownAction": "stopCompose",
  "forwardPorts": [8080],
  "extensions": [
    "ms-azuretools.vscode-docker"
  ],
  "settings": {
    "terminal.integrated.defaultProfile.linux": "bash"
  },
  "remoteUser": "root"
}
